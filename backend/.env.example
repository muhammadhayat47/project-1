# Copy this file to .env and fill in your own values.
# CareerOS runs fully with realistic simulated data even if you leave everything blank -
# these keys just switch specific features from "smart template" mode to "live AI" mode.

# --- Security --------------------------------------------------------------
# Any long random string. Used to sign login sessions (JWT).
SECRET_KEY=change-this-to-a-long-random-string

# --- Optional: OpenAI (Career Copilot roadmaps, cover letters) -------------
# Without this key, the Copilot and Cover Letter modules fall back to a
# rule-based generator that still produces a full, personalized result.
# With it, they call GPT-4o for richer, more nuanced writing.
OPENAI_API_KEY=

# --- Optional: Adzuna Jobs API (real job listings for Auto-Apply) ----------
# Free developer keys: https://developer.adzuna.com
# Without these, Auto-Apply matches against a realistic bundled job dataset.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Optional: SMTP (real password-reset emails) ---------------------------
# Without these, forgot-password still works end-to-end — the reset link
# is logged server-side and returned in the API response for local testing
# (never in production). Any SMTP provider works (Gmail app password,
# SendGrid, Mailgun, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@careeros.app

# --- App ---------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
